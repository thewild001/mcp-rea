# Copie a .env (no se versiona). Todas las variables son opcionales salvo
# MCP_AUTH_TOKEN cuando se usa docker compose o se expone HTTP fuera de loopback.

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL (se escribe en stderr)
LOG_LEVEL=INFO

# ── Transporte hacia los clientes MCP ───────────────────────────────────────
# stdio (defecto) o http
MCP_TRANSPORT=stdio
# Solo http:
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# Obligatorio si MCP_HOST no es loopback. Genere uno con: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ── Backend REA ─────────────────────────────────────────────────────────────
# Por defecto: npx -y --prefer-offline rea-agents@6.4.0 mcp
# Con rea-agents instalado globalmente (npm i -g rea-agents@6.4.0) es más
# rápido y no depende de la red:
# REA_COMMAND=rea-agents
# REA_ARGS=mcp
# Segundos máximos para arrancar REA (en frío npx puede descargar el paquete)
REA_INIT_TIMEOUT=180
# Segundos máximos por llamada a una tool (los análisis nativos grandes tardan)
REA_CALL_TIMEOUT=600

# ── Análisis de binarios nativos (Ghidra, ya incluido en la imagen Docker) ──
# Heap de Ghidra; por defecto 2G. Suba también la memoria del contenedor.
# GHIDRA_HEADLESS_MAXMEM=6G
